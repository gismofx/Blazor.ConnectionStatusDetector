@inject IConnectionStatusDetectorService ConnectionStatus
@implements IDisposable

@if (ConnectionStatus.IsOnline)
{
    @Online
}
else
{
    @Offline
}

@code {
    [Parameter]
    public RenderFragment? Online { get; set; }

    [Parameter]
    public RenderFragment? Offline { get; set; }

    // Store the delegate so we can actually unsubscribe the same instance.
    // The original code used inline lambdas which created new delegate instances
    // on each call, making -= a no-op and leaking the subscription.
    private EventHandler<bool> _handler = default!;

    protected override void OnInitialized()
    {
        _handler = (_, _) => InvokeAsync(StateHasChanged);
        ConnectionStatus.ConnectionStatusChanged += _handler;
    }

    public void Dispose() => ConnectionStatus.ConnectionStatusChanged -= _handler;
}
